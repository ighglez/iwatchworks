# Base de datos PostgreSQL (en Vercel: Storage → Neon, se rellena sola)
DATABASE_URL="postgresql://usuario:clave@host:5432/iwatchworks?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://usuario:clave@host:5432/iwatchworks?sslmode=require"

# URL pública de la web (sin barra final)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Stripe en MODO PRUEBA (claves sk_test_ / whsec_). Si se deja vacío, se usa la pasarela de demostración.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Pasarela de demostración (simula pagos). Nunca activar en producción real.
DEMO_PAYMENTS="true"

# Administrador inicial (lo crea el seed)
ADMIN_EMAIL="admin@iwatchworks.com"
ADMIN_PASSWORD="cambia-esta-contraseña"

# Email transaccional opcional (Resend). Si está vacío, los emails se muestran en consola.
RESEND_API_KEY=""
EMAIL_FROM="IWatchWorks <info@iwatchworks.com>"

# WhatsApp de atención (formato internacional sin +)
NEXT_PUBLIC_WHATSAPP="34600000000"
